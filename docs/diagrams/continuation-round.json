{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "自动续聊：一圈是怎么转的",
    "quality_profile": "standard",
    "output": "continuation-round.html"
  },
  "lanes": [
    { "id": "page", "label": "DeepSeek 页面（MAIN 世界）" },
    { "id": "ext", "label": "扩展" },
    { "id": "relay", "label": "本机中继 dsb" }
  ],
  "phases": [
    { "id": "detect", "label": "识别", "fromCol": 0, "toCol": 1 },
    { "id": "execute", "label": "执行", "fromCol": 2, "toCol": 4, "variant": "dashed" },
    { "id": "replay", "label": "回灌", "fromCol": 5, "toCol": 5, "variant": "emphasis" }
  ],
  "mainPath": [
    "model", "detect", "bridge", "gateway", "tools", "assemble", "arm", "rewrite"
  ],
  "nodes": [
    { "id": "model", "lane": "page", "col": 0, "type": "backend", "label": "模型回答", "sublabel": "排了 send 围栏", "width": 132 },
    { "id": "detect", "lane": "page", "col": 1, "type": "frontend", "label": "detect()", "sublabel": "认出 send 围栏", "width": 132 },
    { "id": "bridge", "lane": "ext", "col": 2, "type": "messagebus", "label": "跨世界上报", "sublabel": "postMessage → background", "width": 132 },
    { "id": "gateway", "lane": "relay", "col": 3, "type": "cloud", "label": "dsb 中继", "sublabel": "tools/call", "width": 132 },
    { "id": "tools", "lane": "relay", "col": 4, "type": "backend", "label": "工具执行", "sublabel": "五件工作工具", "width": 132 },
    { "id": "assemble", "lane": "ext", "col": 4, "type": "backend", "label": "拼结果段", "sublabel": "多块各加一行工具名", "width": 132 },
    { "id": "arm", "lane": "page", "col": 4, "type": "backend", "label": "武装 + 发送", "sublabel": "短标记 + Enter", "width": 132 },
    { "id": "rewrite", "lane": "page", "col": 5, "type": "frontend", "label": "替换出站正文", "sublabel": "fetch hook；模型再答回到 detect", "width": 132 }
  ],
  "edges": [
    { "id": "answer-detect", "from": "model", "to": "detect", "variant": "default" },
    { "id": "detect-bridge", "from": "detect", "to": "bridge", "label": "send 围栏", "variant": "emphasis" },
    { "id": "bridge-gateway", "from": "bridge", "to": "gateway", "variant": "default" },
    { "id": "gateway-tools", "from": "gateway", "to": "tools", "label": "tools/call", "variant": "default" },
    { "id": "tools-assemble", "from": "tools", "to": "assemble", "label": "结果", "variant": "default" },
    { "id": "assemble-arm", "from": "assemble", "to": "arm", "variant": "default" },
    { "id": "arm-rewrite", "from": "arm", "to": "rewrite", "label": "站点发出请求", "variant": "default" }
  ]
}
