{
  "description": "页面动作协议（ADR-0007）。agent 用 POST /action 提交一个最小动作，请求体 {\"action\", \"params\", \"target\"}，带 Authorization: Bearer <token>（写端点验 token）。中继按 target 标签页入阻塞串行队列，经动作流 GET /actions（SSE）推给扩展，扩展在页面执行后回传，这次 POST 原地返回 response。response 成功 {\"ok\":true,\"action\",\"result\"}，失败 {\"ok\":false,\"action\",\"error\"}。",
  "errorCodes": [
    { "code": "unauthorized", "when": "写请求缺 token 或 token 不匹配" },
    { "code": "no-subscriber", "when": "扩展未订阅动作流或已断开" },
    { "code": "disabled", "when": "总开关关着" },
    { "code": "unknown-action", "when": "动作名不在册" },
    { "code": "timeout", "when": "动作推给扩展后超时未回传" },
    { "code": "tab-gone", "when": "目标标签页已不存在" }
  ],
  "cases": [
    {
      "name": "tabs.list 成功",
      "request": { "action": "tabs.list", "params": {}, "target": null },
      "response": {
        "ok": true,
        "action": "tabs.list",
        "result": {
          "tabs": [
            {
              "id": 42,
              "title": "DeepSeek - 深度求索",
              "url": "https://chat.deepseek.com/a/chat/s/abc123"
            }
          ]
        }
      }
    },
    {
      "name": "page.state 成功",
      "request": { "action": "page.state", "params": {}, "target": "42" },
      "response": {
        "ok": true,
        "action": "page.state",
        "result": {
          "url": "https://chat.deepseek.com/a/chat/s/abc123",
          "title": "DeepSeek - 深度求索",
          "composerPresent": true,
          "account": { "kind": "ready" }
        }
      }
    },
    {
      "name": "composer.type 指定标签页成功",
      "request": { "action": "composer.type", "params": { "text": "你好" }, "target": "42" },
      "response": { "ok": true, "action": "composer.type", "result": {} }
    },
    {
      "name": "composer.read 成功",
      "request": { "action": "composer.read", "params": {}, "target": "42" },
      "response": { "ok": true, "action": "composer.read", "result": { "text": "你好" } }
    },
    {
      "name": "messages.list 成功",
      "request": { "action": "messages.list", "params": {}, "target": "42" },
      "response": {
        "ok": true,
        "action": "messages.list",
        "result": {
          "messages": [
            { "role": "user", "text": "帮我看一眼这段代码" },
            { "role": "assistant", "text": "答案是 4271。" }
          ]
        }
      }
    },
    {
      "name": "messages.last 成功",
      "request": { "action": "messages.last", "params": {}, "target": "42" },
      "response": {
        "ok": true,
        "action": "messages.last",
        "result": { "messages": [{ "role": "assistant", "text": "答案是 4271。" }] }
      }
    },
    {
      "name": "chat.new 成功",
      "request": { "action": "chat.new", "params": {}, "target": "42" },
      "response": { "ok": true, "action": "chat.new", "result": {} }
    },
    {
      "name": "send.click 成功",
      "request": { "action": "send.click", "params": {}, "target": "42" },
      "response": { "ok": true, "action": "send.click", "result": {} }
    },
    {
      "name": "send.enter 成功",
      "request": { "action": "send.enter", "params": {}, "target": "42" },
      "response": { "ok": true, "action": "send.enter", "result": {} }
    },
    {
      "name": "composer.clear 成功",
      "request": { "action": "composer.clear", "params": {}, "target": "42" },
      "response": { "ok": true, "action": "composer.clear", "result": {} }
    },
    {
      "name": "未订阅失败",
      "request": { "action": "tabs.list", "params": {}, "target": null },
      "response": { "ok": false, "action": "tabs.list", "error": "no-subscriber" }
    },
    {
      "name": "总开关关闭失败",
      "request": { "action": "tabs.list", "params": {}, "target": null },
      "response": { "ok": false, "action": "tabs.list", "error": "disabled" }
    },
    {
      "name": "未知动作失败",
      "request": { "action": "page.nope", "params": {}, "target": null },
      "response": { "ok": false, "action": "page.nope", "error": "unknown-action" }
    },
    {
      "name": "目标标签页不存在失败",
      "request": { "action": "page.state", "params": {}, "target": "99999" },
      "response": { "ok": false, "action": "page.state", "error": "tab-gone" }
    },
    {
      "name": "token 无效失败",
      "request": { "action": "tabs.list", "params": {}, "target": null },
      "response": { "ok": false, "action": "tabs.list", "error": "unauthorized" }
    }
  ]
}
