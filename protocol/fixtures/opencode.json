{
  "description": "中继对拍：opencode 的各类结果 → status 载荷（只产结构化 dict，TOON 编码归扩展）。",
  "cases": [
    {
      "name": "opencode 成功答复",
      "outcome": {
        "kind": "success",
        "body": [
          {
            "role": "user",
            "parts": [{ "type": "text", "text": "```send\nrepo 里 dsb 的入口在哪？\n```" }]
          },
          {
            "role": "assistant",
            "parts": [{ "type": "text", "text": "入口在 dsb/server.py。" }]
          }
        ]
      },
      "expectedPayload": { "status": "ok", "answer": "入口在 dsb/server.py。" }
    },
    {
      "name": "opencode 成功答复含多段文本",
      "outcome": {
        "kind": "success",
        "body": [
          {
            "role": "assistant",
            "parts": [
              { "type": "text", "text": "第一行" },
              { "type": "text", "text": "第二行" }
            ]
          }
        ]
      },
      "expectedPayload": { "status": "ok", "answer": "第一行\n第二行" }
    },
    {
      "name": "opencode 服务没起",
      "outcome": { "kind": "not-running" },
      "expectedPayload": { "status": "error", "error": "opencode-not-running" }
    },
    {
      "name": "opencode 超时",
      "outcome": { "kind": "timeout" },
      "expectedPayload": { "status": "error", "error": "opencode-timeout" }
    },
    {
      "name": "opencode 返回非预期响应",
      "outcome": { "kind": "success", "body": { "note": "opencode 返回了不认识的形状" } },
      "expectedPayload": { "status": "error", "error": "unexpected-response" }
    },
    {
      "name": "opencode 返回 http 错误",
      "outcome": { "kind": "http-error", "status": 500 },
      "expectedPayload": { "status": "error", "error": "unexpected-response" }
    }
  ]
}
